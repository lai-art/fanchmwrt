config ndis
	option enable '1'
	option simsel '0'
	option smode '0'
	option bandlist_nr '0'
	option pingen '0'
	option pingaddr '119.29.29.29'
	option count '5'
	option enable_weburl '1'
	option weburl 'www.baidu.com'
	option enable_reconnect '0'
	option enable_imei2 '0'
	option enable_imei '0'
	option connection_type 'SERIAL'
	option serial_port '/dev/ttyUSB1'
	option baudrate '115200'
	option serial_timeout '10'
	option log_file 'notifications.log'
	option notification_sms '1'
	option notification_call '1'
	option notification_memory_full '1'
	option notification_signal '0'
	option protocol_type 'IPV4'
	option websocket_host '0.0.0.0'
	option websocket_port '8766'
	option ipv6mode 'full'
	option smsen '0'
	option rshowtime '1'
	option showtime '20'
