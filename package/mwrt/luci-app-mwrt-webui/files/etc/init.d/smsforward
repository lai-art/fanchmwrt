#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=01

NAME=smsforward
PROG=/usr/bin/smsforward
SMSBIN=/usr/libexec/mwrt-sms

# NRadio C5800 only: 这台机型没有 qmodem, 固件里没有 tom_modem, 而 smsforward 是写死去调 tom_modem 读短信的,
# 所以前置一个只在这里生效的替身目录(它转给 sendat: 接了 AK68 读 AK68 的卡, 没接读内置模组的卡)。
# 别的机型(tom_modem 是 qmodem 包自带的真货)这里一行都不生效。
is_c5800() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)|$(cat /tmp/sysinfo/model 2>/dev/null)" in
		*[Cc]5800*) return 0 ;;
	esac
	return 1
}

start_service() {
	config_load "$NAME"

	local enable
	config_get enable settings enable
	[ "$enable" = "1" ] || { echo "Instance \"$NAME\" disabled."; return 1; }

	local penv=""
	if is_c5800 && [ ! -x /usr/bin/tom_modem ] && [ -x "$SMSBIN/tom_modem" ]; then
		penv="PATH=$SMSBIN:\$PATH; export PATH; "
		# 转发记录按读取来源分开存(内置卡/每台 AK68 各一份), 来源变了先换成对应那份, 免得把另一张卡里的旧短信当成新短信全转一遍
		[ -x "$SMSBIN/smssrc" ] && "$SMSBIN/smssrc" sync
	fi

	procd_open_instance
	procd_set_param command /bin/sh -c "${penv}rm -f /tmp/smsforward.lock; exec '$PROG'"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/smsforward.lock
	rm -f /var/run/$NAME.pid
}
