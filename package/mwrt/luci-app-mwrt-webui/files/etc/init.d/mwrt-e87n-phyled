#!/bin/sh /etc/rc.common
# EdgePi E87N only: re-apply the RTL8221B LAN port LED mapping whenever the PHY
# loses it (see /usr/bin/mwrt-e87n-phyled). Any other board: no instance is started.

USE_PROCD=1
START=96
STOP=10

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "edgepi,e87n" ] || return 0
	[ -x /usr/bin/python3 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/mwrt-e87n-phyled
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
