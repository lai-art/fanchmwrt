#!/bin/sh /etc/rc.common
# NRadio C5800 only: ATSD(AK68 的 AT 口 TCP 代理)。接了 AK68 后 WEBUI / LED 的 AT 都从这里走(atsd_tools_cli -i cpe)。
# 只由 /usr/bin/mwrt-ak68 守护在识别到 AK68 之后拉起(它先立 /tmp/mwrt-ak68.atsdgo 再 restart 本服务);
# 开机自启时没有这个标志, 什么也不起; 其它机型同样什么也不起。

START=14
STOP=92

USE_PROCD=1

loop_atsd_tools() {
	local rule=$1
	procd_open_instance
	procd_set_param command /usr/bin/atsd_tools -i "$rule"
	procd_set_param respawn 5 5 -1
	procd_close_instance
}

start_service() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)|$(cat /tmp/sysinfo/model 2>/dev/null)" in
		*[Cc]5800*) ;;
		*) return 0 ;;
	esac
	[ -e /tmp/mwrt-ak68.atsdgo ] || return 0
	config_load atsd_tools
	config_foreach loop_atsd_tools channel
}
