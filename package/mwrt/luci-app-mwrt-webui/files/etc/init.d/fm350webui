#!/bin/sh /etc/rc.common
# FM350 / RM520 WEBUI 后端(轻量 Lua 版 /usr/bin/fm350ws)。
# 替换 modeminit 里裸起的 `python3 /usr/bin/fm350webserver.py &`(常驻约 25MB,Lua 版约 1.5MB):
#   这里改 procd 托管、带 respawn;只有 modeminit / 后台「重启 webui」识别到 FM350/7127/520 时才会调 start,
#   不 enable(不随开机自启)——和 modemwebui(只管 5700)互不干扰。
USE_PROCD=1
START=99
STOP=10

start_service() {
	/etc/init.d/genwebui stop 2>/dev/null   # 通用 WEBUI 也用 8766,不能同时在
	# 从老固件升上来可能还有旧 python 服务占着 8766,先收掉
	ps w | grep '[f]m350webserver.py' | awk '{print $1}' | xargs -r kill -9 2>/dev/null
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/fm350ws
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
