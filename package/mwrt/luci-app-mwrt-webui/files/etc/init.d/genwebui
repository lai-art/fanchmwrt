#!/bin/sh /etc/rc.common
# 通用 WEBUI 后端(Lua 版 /usr/bin/genws,数据来自 QModem,常驻约 2MB),监听 8766。
# 只有 modeminit 识别到「非 5700/350/520 的其它模组」时才会调 start,不 enable(不随开机自启);
# 和 fm350webui 共用 8766,两边的 start 都会先停对方。
USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/genws 8766
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
