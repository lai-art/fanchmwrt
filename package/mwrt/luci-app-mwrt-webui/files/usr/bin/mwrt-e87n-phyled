#!/usr/bin/python3
# EdgePi E87N only: keep the RTL8221B (LAN, eth0, MDIO addr 3) LED registers at the
# values the device tree asks for.
#
# Why: the E87N dts carries realtek,led-link-select = <0xa7 0xa7 0x0> but the 6.6.94
# kernel has no code that reads it, so the PHY stays at its defaults (LED0 only on
# 10/100M, LED1 only on 1G, LED2 only on 2.5G) and the port LEDs look dead or wrong
# at most speeds. Every eth0 close/open re-runs the PHY config_init and puts the
# defaults back, so a one-shot write at boot is not enough: this watches and
# rewrites only when the registers have drifted.
#
# Registers (MMD 31): d032/d034/d036 = LED0/1/2 link-speed select, d040 = activity
# select/blink timing. Only the blink period field of d040 (bits 11:8) is touched,
# every other bit is kept; d044 (polarity) is never written.
# Blink timing 0x2 was accepted by the user on the real unit ("节奏舒服了");
# the factory value is 0x9.
#
# Safe by construction: does nothing unless board_name is edgepi,e87n AND the PHY at
# eth0/3 identifies as Realtek RTL8221B-VB-CG (id 001c:c849).
import fcntl, socket, struct, sys, time

IFACE, PHY, MMD = 'eth0', 3, 31
LINK = {0xd032: 0xa7, 0xd034: 0xa7, 0xd036: 0x0000}
ACT, ACT_MASK, ACT_VAL = 0xd040, 0x0f00, 0x0200
POLL = 2


def board():
    try:
        return open('/tmp/sysinfo/board_name').read().strip()
    except OSError:
        return ''


def mii(req, dev, reg, val=0):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        ifr = struct.pack('16sHHHH', IFACE.encode(), 0x8000 | (PHY << 5) | dev, reg, val, 0) + b'\0' * 8
        return struct.unpack('16sHHHH', fcntl.ioctl(s, req, ifr)[:24])[4]
    finally:
        s.close()


def rd(dev, reg):
    return mii(0x8948, dev, reg)


def wr(dev, reg, val):
    mii(0x8949, dev, reg, val)


def apply():
    for r, v in LINK.items():
        if rd(MMD, r) != v:
            wr(MMD, r, v)
    cur = rd(MMD, ACT)
    want = (cur & ~ACT_MASK) | ACT_VAL
    if cur != want:
        wr(MMD, ACT, want)


def main():
    if board() != 'edgepi,e87n':
        return 0
    one = len(sys.argv) > 1 and sys.argv[1] == 'once'
    ident = None
    while ident is None:
        try:
            ident = (rd(1, 2), rd(1, 3))
        except OSError:
            if one:
                return 1
            time.sleep(POLL)
    if ident != (0x001c, 0xc849):
        sys.stderr.write('mwrt-e87n-phyled: unexpected PHY id %04x:%04x, leaving it alone\n' % ident)
        return 0
    while True:
        try:
            apply()
        except OSError:
            if one:
                return 1
        if one:
            return 0
        time.sleep(POLL)


sys.exit(main())
