#!/usr/bin/lua
-- smssend - 经 AT 口用 PDU 模式发短信(纯 Lua 版, 取代原 python3 版)
-- 7981 固件没有 python3, 原脚本直接 "env: can't execute 'python3'"。逻辑/输出与 python 版一致:
--
-- 为什么单行发: 鲲鹏 MT5700M-CN 不实现 AT+CMGS 的两段式握手(没有 '>' 提示符),
-- 只认 "AT+CMGS=<len>\r<PDU>" 单行(\r 是字面的反斜杠+r), 正是 /usr/bin/pdul.lua 的输出格式。
--
-- 用法:
--   smssend <号码> <正文>          发送, 打印一行 JSON
--   smssend --dry <号码> <正文>    只编码, 打印 PDU, 不碰串口
-- 输出: {"number": "8613...", "toa": "91", "segments": 1, "refs": [44], "ok": true}
--       {"error": "...", "refs": [], "segments": 2, "sent": 1, "ok": false}

local PDUL = "/usr/bin/pdul.lua"
local SENDAT = "/usr/bin/sendat"
local SMS_TOOL = "/usr/bin/sms_tool_q"
local PORT_CACHE = "/tmp/sendat.atport"
local LOCKFILE = "/tmp/sendat.at.lock"
local AT_INDEX = "1"
local SEND_TIMEOUT = 40

local function shq(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function jstr(s)
    local esc = { ['"'] = '\\"', ["\\"] = "\\\\", ["\b"] = "\\b", ["\f"] = "\\f",
        ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }
    return '"' .. tostring(s):gsub('[%c"\\]', function(c)
        return esc[c] or string.format("\\u%04x", c:byte())
    end) .. '"'
end

local function jval(v)
    local t = type(v)
    if t == "boolean" then return v and "true" or "false" end
    if t == "number" then return tostring(v) end
    if t == "table" then
        local o = {}
        for _, x in ipairs(v) do o[#o + 1] = jval(x) end
        return "[" .. table.concat(o, ", ") .. "]"
    end
    return jstr(v)
end

-- 与 python 版同一字段顺序: 先写入顺序的字段, "ok" 最后
local function emit(ok, fields)
    local o = {}
    for _, kv in ipairs(fields or {}) do
        o[#o + 1] = jstr(kv[1]) .. ": " .. jval(kv[2])
    end
    o[#o + 1] = '"ok": ' .. (ok and "true" or "false")
    io.write("{", table.concat(o, ", "), "}\n")
    os.exit(ok and 0 or 1)
end

local function readall(cmd)
    local p = io.popen(cmd, "r")
    if not p then return "" end
    local s = p:read("*a") or ""
    p:close()
    return s
end

-- 返回 (digits, toa); 不合法返回 nil
local function normalize(raw)
    local text = (raw or ""):gsub("[%s%-()]", "")
    local digits, international
    if text:sub(1, 1) == "+" then
        digits, international = text:sub(2), true
    elseif text:sub(1, 2) == "00" and #text > 8 then
        digits, international = text:sub(3), true
    else
        digits, international = text, false
    end
    if digits == "" or digits:find("%D") or #digits < 2 or #digits > 20 then
        return nil
    end
    if international then return digits, "91" end
    if #digits == 11 and digits:sub(1, 1) == "1" then return "86" .. digits, "91" end
    if #digits >= 12 and digits:sub(1, 2) == "86" then return digits, "91" end
    return digits, "81"
end

local function encode(digits, text)
    local out = readall("lua " .. PDUL .. " '' " .. shq(digits) .. " " .. shq(text) .. " 2>/dev/null")
    local lines = {}
    for l in (out .. "\n"):gmatch("([^\n]*)\n") do
        l = l:gsub("^%s+", ""):gsub("%s+$", "")
        if l:find("\\r", 1, true) then lines[#lines + 1] = l end
    end
    if #lines == 0 then return nil end
    return lines
end

-- 单段且没有 UDH 的 PDU 清掉 UDHI 位(pdul.lua 恰好 limit 长度时会错置)
local function fix_udhi(line)
    local s, e = line:find("\\r", 1, true)
    if not s then return line end
    local head, body = line:sub(1, s - 1), line:sub(e + 1)
    if #body < 6 or body:sub(1, 2) ~= "00" then return line end
    local t = tonumber(body:sub(3, 4), 16)
    if not t then return line end
    if math.floor(t / 64) % 2 == 0 then return line end
    return head .. "\\r" .. body:sub(1, 2) .. string.format("%02X", t - 64) .. body:sub(5)
end

-- 目的地址 TOA 在 SMSC 为空的 PDU 里恒在偏移 8
local function retarget(line, toa)
    local s, e = line:find("\\r", 1, true)
    if not s then return line end
    local head, body = line:sub(1, s - 1), line:sub(e + 1)
    if #body < 12 or body:sub(1, 2) ~= "00" then return line end
    return head .. "\\r" .. body:sub(1, 8) .. toa .. body:sub(11)
end

local function at(command, timeout)
    timeout = timeout or 8
    return readall(SENDAT .. " " .. AT_INDEX .. " " .. shq(command) .. " " .. timeout .. " 2>/dev/null")
end

local function at_error(resp)
    local m = resp:match("%+CM[SE] ERROR:%s*([^\r\n]+)")
    if m then return (m:gsub("%s+$", "")) end
    for l in (resp:gsub("\r", "") .. "\n"):gmatch("([^\n]*)\n") do
        if l:match("^%s*ERROR%s*$") then return "ERROR" end
    end
    return "no +CMGS response"
end

local function exists(p)
    local f = io.open(p, "r")
    if f then f:close() return true end
    return false
end

-- 只在单行形式失败时兜底: 需要 '>' 提示符的标准模组走 sms_tool_q; true/false/nil
local function fallback(number, text)
    if not exists(SMS_TOOL) then return nil end
    local f = io.open(PORT_CACHE, "r")
    if not f then return nil end
    local port = (f:read("*a") or ""):gsub("%s+", "")
    f:close()
    if port == "" or not exists(port) then return nil end
    local p = io.popen("flock -x " .. LOCKFILE .. " " .. SMS_TOOL .. " -d " .. shq(port) ..
        " send " .. shq(number) .. " " .. shq(text) .. " >/dev/null 2>&1; echo $?")
    if not p then return nil end
    local rc = tonumber((p:read("*a") or ""):match("%d+"))
    p:close()
    return rc == 0
end

local function main()
    local argv = {}
    for i = 1, #arg do argv[#argv + 1] = arg[i] end
    local dry = false
    if argv[1] == "--dry" then
        dry = true
        table.remove(argv, 1)
    end
    if #argv < 2 then
        emit(false, { { "error", "usage: smssend [--dry] <number> <text>" } })
    end

    local number, text = argv[1], argv[2]
    local digits, toa = normalize(number)
    if not digits then emit(false, { { "error", "invalid destination number" } }) end
    if text == "" then emit(false, { { "error", "empty message" } }) end

    -- pdul.lua 的 UCS2 编码只认 1..3 字节 UTF-8, BMP 外(emoji)会整条编不出
    if text:find("[\240-\247]") then
        emit(false, { { "error", "unsupported character (emoji)" } })
    end

    local segments = encode(digits, text)
    if not segments then emit(false, { { "error", "PDU encoding failed" } }) end
    if #segments == 1 then segments = { fix_udhi(segments[1]) } end
    if toa ~= "91" then
        for i, s in ipairs(segments) do segments[i] = retarget(s, toa) end
    end

    if dry then
        emit(true, { { "number", digits }, { "toa", toa }, { "segments", #segments }, { "pdu", segments } })
    end

    -- 厂商网页会把模组切到文本模式读短信, 文本模式下发 PDU 会变乱码, 先切回 PDU 模式
    at("AT+CMGF=0", 5)
    local refs = {}
    for position, segment in ipairs(segments) do
        local resp = at("AT+CMGS=" .. segment, SEND_TIMEOUT)
        local found = resp:match("%+CMGS:%s*(%d+)")
        if found then
            refs[#refs + 1] = tonumber(found)
        else
            -- 先清掉半开的提示符再做别的
            at("\27", 3)
            if position == 1 then
                local handled = fallback(digits, text)
                if handled then
                    emit(true, { { "number", digits }, { "toa", toa }, { "segments", 1 },
                        { "refs", {} }, { "via", "sms_tool_q" } })
                end
                if handled == false then
                    emit(false, { { "error", "sms_tool_q refused the message" }, { "number", digits },
                        { "toa", toa }, { "segments", #segments }, { "sent", 0 }, { "refs", refs } })
                end
            end
            emit(false, { { "error", at_error(resp) }, { "number", digits }, { "toa", toa },
                { "segments", #segments }, { "sent", #refs }, { "refs", refs } })
        end
    end
    emit(true, { { "number", digits }, { "toa", toa }, { "segments", #segments }, { "refs", refs } })
end

main()
