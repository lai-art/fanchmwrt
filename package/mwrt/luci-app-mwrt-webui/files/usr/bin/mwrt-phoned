#!/usr/bin/lua
-- mwrt-phoned: 5700 模组通话/短信状态守护(s101)
--
-- 只做一件事: 经 sendat(带 /tmp/sendat.at.lock 的 flock 串行)低频轮询只读 AT,
-- 把结果写进 /tmp/mwrt-phone/ 下的 state.json / events,供 LuCI 接口 phone_state 读取。
--   - AT+CLCC      通话状态(空闲/振铃/拨号/通话)
--   - AT+CPMS?     短信占用格数,变化时才去读短信
--   - AT+CMGL=4    读短信(经 pdu_decoder --json),只用于发现新短信
--   - AT^IMSSWITCH? IMS 开关(只读)
-- 本进程【绝不】发送 ATD/ATA/ATH/CHUP/CFUN/CMGS/CMGD/CNMI=/CLIP=/CRC= 等写入类命令,
-- 写路径(拨号/接听/挂断)只在 mwrt-phone-ctl 里,守护只通过 hint 文件得知。
-- 也绝不自己打开 ttyUSB 口(历史上抢口造成过 tom_modem PID 耗尽),一律走 sendat。
--
-- 环境变量(测试钩子,生产环境全部不设):
--   MWRT_PHONE_DIR / MWRT_PHONE_SENDAT / MWRT_PHONE_PDU / MWRT_PHONE_MODCONF / MWRT_PHONE_USBDIR
--   MWRT_PHONE_RMLOCK / MWRT_PHONE_UCI_ARGS / MWRT_PHONE_BOOT_UPTIME / MWRT_PHONE_T_* (各间隔常量)
--   MWRT_PHONE_LIB=1  只返回函数表,不进入主循环(单元测试用)
--
-- 单例: 本进程自己对 daemon.lock 做 nixio lockf,抢不到 exit 3。
-- 不再依赖 busybox flock 包一层: busybox flock 会 fork 出子进程,procd stop 只杀 flock 本身,会留孤儿守护。

local nixio = require "nixio"
local nfs = require "nixio.fs"      -- 带 Lua 层的 readfile/writefile/mkdirr(单取 nixio.fs 原生表没有 readfile)
local jsonc = require "luci.jsonc"

local function envs(name, def)
	local v = os.getenv(name)
	if v and v ~= "" then return v end
	return def
end

local function envn(name, def)
	local v = tonumber(os.getenv(name) or "")
	if v then return v end
	return def
end

local D = envs("MWRT_PHONE_DIR", "/tmp/mwrt-phone")
local PDU = envs("MWRT_PHONE_PDU", "/usr/bin/pdu_decoder")
local MODCONF = envs("MWRT_PHONE_MODCONF", "/tmp/modconf.conf")
local USBDIR = envs("MWRT_PHONE_USBDIR", "/sys/bus/usb/devices")
local RMLOCK = envs("MWRT_PHONE_RMLOCK", "/tmp/rm520n.lock")
local UCI_ARGS = envs("MWRT_PHONE_UCI_ARGS", "")

-- 节奏常量(秒)。设计稿 A 节; 环境变量只给测试缩短用。
local C = {
	seen_win    = envn("MWRT_PHONE_SEEN_WIN", 30),    -- seen 文件 mtime 在这么久以内算"有人在看"
	idle_seen   = envn("MWRT_PHONE_T_IDLE_SEEN", 1.5),
	idle_unseen = envn("MWRT_PHONE_T_IDLE_UNSEEN", 6),
	call        = envn("MWRT_PHONE_T_CALL", 1),
	call_max    = envn("MWRT_PHONE_T_CALL_MAX", 2),
	bo1         = envn("MWRT_PHONE_T_BO1", 5),        -- 连续 2 次失败后的空闲间隔
	bo2         = envn("MWRT_PHONE_T_BO2", 10),       -- 连续 4 次失败后的空闲间隔
	boot        = envn("MWRT_PHONE_BOOTWAIT", 180),   -- 开机后这么久内不发任何 AT
	hold        = envn("MWRT_PHONE_ENDED_HOLD", 4),
	stall       = envn("MWRT_PHONE_STALL", 30),
	dialfail    = envn("MWRT_PHONE_DIAL_FAIL", 10),
	hang_hint   = envn("MWRT_PHONE_HANG_HINT", 10),
	partial     = envn("MWRT_PHONE_PARTIAL", 60),
	cpms_seen   = envn("MWRT_PHONE_T_CPMS_SEEN", 10),
	cpms_unseen = envn("MWRT_PHONE_T_CPMS_UNSEEN", 30),
	full_seen   = envn("MWRT_PHONE_T_FULL_SEEN", 600),
	full_unseen = envn("MWRT_PHONE_T_FULL_UNSEEN", 1800),
	cfg_every   = envn("MWRT_PHONE_T_CFG", 30),
	ims_every   = envn("MWRT_PHONE_T_IMS", 300),
	-- s103: IMS(短信开关)为关闭期间加快只读复查,用户去设置页打开后一分钟内状态自动变为可用
	ims_fast    = envn("MWRT_PHONE_T_IMS_FAST", 30),
	recheck     = envn("MWRT_PHONE_T_RECHECK", 30),
	heartbeat   = envn("MWRT_PHONE_T_HEARTBEAT", 10),
	sms_retry   = envn("MWRT_PHONE_T_SMS_RETRY", 30),
	loop        = envn("MWRT_PHONE_T_LOOP", 0.25),
	seen_max    = 200,
	events_max  = 50,
	sms_burst   = 5,
}

local M = { C = C }

------------------------------------------------------------------ 小工具

local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

local function shq(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end

local function mono()
	local f = io.open("/proc/uptime", "r")
	if not f then return os.time() end
	local s = f:read("*l")
	f:close()
	return tonumber(s and s:match("^([%d%.]+)")) or os.time()
end
M.mono = mono

local function sleep_s(sec)
	local whole = math.floor(sec)
	nixio.nanosleep(whole, math.floor((sec - whole) * 1e9))
end

local function atomic_write(path, data)
	local tmp = path .. ".tmp"
	local f = io.open(tmp, "w")
	if not f then return false end
	f:write(data)
	f:close()
	return nfs.rename(tmp, path)
end

-- 单次 popen,必定 close,不泄漏子进程句柄。
local runner = function(cmd)
	local p = io.popen(cmd .. " 2>/dev/null", "r")
	if not p then return "" end
	local out = p:read("*a") or ""
	p:close()
	return out
end
function M.set_runner(fn) runner = fn end

-- 截断到 n 个 UTF-8 字符,换行/控制字符换成空格。
local function clip_text(s, n)
	s = tostring(s or ""):gsub("[%c]", " ")
	local i, cnt, len = 1, 0, #s
	while i <= len do
		local b = s:byte(i)
		local step = (b >= 240 and 4) or (b >= 224 and 3) or (b >= 192 and 2) or 1
		cnt = cnt + 1
		if cnt > n then return s:sub(1, i - 1) end
		i = i + step
	end
	return s
end
M.clip_text = clip_text

local function djb2(s)
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + s:byte(i)) % 4294967296
	end
	return h
end
M.djb2 = djb2

------------------------------------------------------------------ sendat

local function sendat_path()
	local e = os.getenv("MWRT_PHONE_SENDAT")
	if e and e ~= "" then return e, "env" end
	local ov = nfs.readfile(D .. "/sendat.override", 256)
	if ov then
		ov = trim(ov)
		if ov:sub(1, 5) == "/tmp/" and not ov:find("[^%w%._/%-]") and nfs.access(ov, "x") then
			return ov, "override"
		end
	end
	return "/usr/bin/sendat", "real"
end
M.sendat_path = sendat_path

------------------------------------------------------------------ 回包解析

-- 返回 kind, calls:
--   "calls", {{idx,dir,stat,mode,mpty,number}...}   有通话行,只解析 +CLCC: 开头的行
--   "idle"                                           整段非空行恰为一个 OK
--   "unknown"                                        其余(空、超时、错位、被 URC 污染)
function M.parse_clcc(raw)
	raw = tostring(raw or ""):gsub("\r", "")
	local calls, nonempty, only, bad, haveline = {}, 0, nil, false, false
	for line in raw:gmatch("[^\n]+") do
		line = trim(line)
		if line ~= "" then
			nonempty = nonempty + 1
			only = line
			if line:sub(1, 6) == "+CLCC:" then
				haveline = true
				local idx, dir, stat, mode, mpty, rest =
					line:match('^%+CLCC:%s*(%d+),(%d+),(%d+),(%d+),(%d+)(.*)$')
				if not idx then
					bad = true
				else
					local number = ""
					if rest ~= "" then
						local n = rest:match('^,"([^"]*)"')
						if n then
							number = n:gsub("[^%d%+%*#]", ""):sub(1, 32)
						elseif not rest:match("^,%s*$") then
							bad = true
						end
					end
					calls[#calls + 1] = { idx = tonumber(idx), dir = tonumber(dir),
						stat = tonumber(stat), mode = tonumber(mode), mpty = tonumber(mpty), number = number }
				end
			end
		end
	end
	if haveline then
		if bad or #calls == 0 then return "unknown" end
		return "calls", calls
	end
	if nonempty == 1 and only == "OK" then return "idle" end
	return "unknown"
end

-- +CPMS: "SM",0,50,"SM",0,50,"SM",0,50  只取首三元,且同一回包必须有 OK 行。
function M.parse_cpms(raw)
	raw = tostring(raw or ""):gsub("\r", "")
	local mem, used, total
	local ok = false
	for line in raw:gmatch("[^\n]+") do
		line = trim(line)
		if line == "OK" then ok = true end
		if not mem then
			local a, b, c = line:match('^%+CPMS:%s*"([A-Z_]+)",(%d+),(%d+)')
			if a then mem, used, total = a, tonumber(b), tonumber(c) end
		end
	end
	if mem and ok then return { mem = mem, used = used, total = total } end
	return nil
end

-- ^IMSSWITCH: 1,0,0 → 1
function M.parse_ims(raw)
	raw = tostring(raw or ""):gsub("\r", "")
	local v
	local ok = false
	for line in raw:gmatch("[^\n]+") do
		line = trim(line)
		if line == "OK" then ok = true end
		local a = line:match("^%^IMSSWITCH:%s*(%-?%d+)")
		if a and not v then v = tonumber(a) end
	end
	if v and ok then return (v == 1) and 1 or 0 end
	return nil
end

------------------------------------------------------------------ 状态

local function blank_call()
	return { state = "idle", dir = "", number = "", cid = 0, waiting = 0, held = 0,
		ring_ts = 0, active_ts = 0, end_ts = 0, dur = 0, answered = 0, reason = "", silent = 0 }
end

local S, I, events

local function read_int_file(path, def)
	local v = tonumber(trim(nfs.readfile(path, 32) or ""))
	return v and math.floor(v) or def
end

-- s101rel: gen 以前只是启动时的 epoch 秒。板子无 RTC 时每次开机的 epoch 近乎相同,
-- 重启后 gen 可能与浏览器里记下的一样而 seq 从 0 重来,前端会把新事件当成"已处理"而不弹短信。
-- 加 8 位随机十六进制(内核每次读都给新的 uuid)保证每次启动都不同。
local function new_gen()
	local u = (nfs.readfile("/proc/sys/kernel/random/uuid", 64) or ""):gsub("[^%x]", ""):sub(1, 8)
	if u == "" then u = string.format("%x", math.floor(mono() * 1000)) end
	return tostring(os.time()) .. "-" .. u
end

function M.reset(persist)
	S = {
		supported = true, gen = new_gen(), seq = 0, health = "booting", ims = -1,
		cfg = { sms = 1, call = 1, phoneen = 1 },
		call = blank_call(),
		sms = { used = 0, total = 0, mem = "SM", full = 0 },
	}
	I = {
		persist = persist and true or false,
		cidn = 0,
		clean = 0, seen_line = false, dial_mono = 0, hang_mono = nil, ans_mono = nil,
		active_mono = nil, ended_mono = 0, last_valid = 0,
		fails = 0, ofails = 0,
		next_clcc = 0, next_cpms = 0, next_cfg = 0, next_recheck = 0, next_ims = 0,
		next_full = 0, next_sms_retry = 0, last_used = nil, baseline_done = false,
		seen = {}, seen_list = {}, inc = {},
		at_total = 0, at_fail = 0, sig = "", last_write = 0,
		seen_cache_t = -100, seen_cache = false,
	}
	events = {}
	M.S, M.I = S, I
	M.events = events
end

local function write_events()
	if not I.persist then return end
	local lines = {}
	for _, ev in ipairs(events) do lines[#lines + 1] = jsonc.stringify(ev) end
	atomic_write(D .. "/events", table.concat(lines, "\n") .. (#lines > 0 and "\n" or ""))
end

local function emit(ev)
	S.seq = S.seq + 1
	ev.id = S.seq
	ev.ts = os.time()
	ev.number = ev.number or ""
	ev.dir = ev.dir or ""
	ev.answered = ev.answered or 0
	ev.duration = ev.duration or 0
	ev.reason = ev.reason or ""
	ev.sender = ev.sender or ""
	ev.text = ev.text or ""
	ev.partial = ev.partial or 0
	events[#events + 1] = ev
	while #events > C.events_max do table.remove(events, 1) end
	if I.persist then
		atomic_write(D .. "/seq", tostring(S.seq) .. "\n")
		write_events()
	end
	return ev
end

local function touch_sig()
	local c = S.call
	return table.concat({ tostring(S.supported), S.health, tostring(S.ims), S.cfg.sms, S.cfg.call,
		c.state, c.dir, c.number, c.cid, c.waiting, c.held, c.answered, c.reason, c.silent, c.end_ts,
		S.sms.used, S.sms.total, S.sms.mem, S.sms.full, S.seq }, "|")
end

local function update_dur(t)
	local c = S.call
	if c.state == "active" and I.active_mono then
		c.dur = math.max(0, math.floor(t - I.active_mono))
	end
end

local function new_call(dir, state, number, t)
	I.cidn = I.cidn + 1
	if I.persist then atomic_write(D .. "/cid", tostring(I.cidn) .. "\n") end
	S.call = blank_call()
	M.S = S
	local c = S.call
	c.cid = I.cidn
	c.dir = dir
	c.state = state
	c.number = number or ""
	c.ring_ts = os.time()
	c.silent = (state == "ringing" and S.cfg.call == 0) and 1 or 0
	I.clean, I.seen_line, I.hang_mono, I.ans_mono = 0, false, nil, nil
	I.active_mono = nil
	I.last_valid = t
	I.dial_mono = t
	return c
end

local function go_active(t)
	local c = S.call
	c.state = "active"
	c.answered = 1
	c.active_ts = os.time()
	I.active_mono = t
	c.dur = 0
end

local function end_call(t, forced)
	local c = S.call
	if c.state == "idle" or c.state == "ended" then return end
	local reason
	if I.hang_mono and (t - I.hang_mono) <= C.hang_hint then
		reason = "local"
	elseif forced then
		reason = forced
	elseif c.answered == 1 then
		reason = "remote"
	elseif c.dir == "in" then
		reason = "missed"
	else
		reason = "remote"
	end
	update_dur(t)
	c.state = "ended"
	c.reason = reason
	c.end_ts = os.time()
	I.ended_mono = t
	emit({ type = "call_end", number = c.number, dir = c.dir, answered = c.answered,
		duration = c.dur, reason = reason })
end

local PRIORITY = { [0] = 1, [4] = 2, [3] = 3, [2] = 4, [1] = 5 }

local function pick_main(calls)
	local main, waiting, held = nil, 0, 0
	for _, cl in ipairs(calls) do
		if cl.stat == 5 then
			waiting = 1
		else
			if cl.stat == 1 then held = 1 end
			local p = PRIORITY[cl.stat]
			if p and (not main or p < PRIORITY[main.stat]) then main = cl end
		end
	end
	return main, waiting, held
end

local function has_stat(calls, s)
	for _, cl in ipairs(calls) do
		if cl.stat == s then return true end
	end
	return false
end

local STAT_STATE = { [4] = "ringing", [2] = "dialing", [3] = "alerting", [0] = "active", [1] = "active" }

-- 一次有效 CLCC 观测。kind: "idle" | "calls";  t: 单调时钟秒
function M.apply_obs(kind, calls, t)
	local c = S.call
	I.last_valid = t
	if kind == "idle" then
		if c.state == "idle" or c.state == "ended" then return end
		-- 本地挂断 hint 在 10 秒内: 一次干净空闲即可结束
		if I.hang_mono and (t - I.hang_mono) <= C.hang_hint then
			end_call(t)
			return
		end
		if c.state == "dialing" and not I.seen_line then
			-- 拨号 hint 之后 CLCC 一直没有行: 超过 dialfail 秒才判失败
			if t - I.dial_mono >= C.dialfail then end_call(t, "failed") end
			return
		end
		I.clean = I.clean + 1
		if I.clean >= 2 then end_call(t) end
		return
	end

	-- kind == "calls"
	local main, waiting, held = pick_main(calls)
	if not main then
		-- 只有呼叫等待行(stat=5)或 stat 不认识的行: 不触发来电层。
		-- s101rel: 此时没有任何可用主行,说明当前这一通已经结束,按"干净空闲"计数(连续 2 次才结束);
		-- 以前这里直接 return 且 last_valid 被刷新,通话态会永远卡住、30 秒兜底也失效。
		if c.state ~= "idle" and c.state ~= "ended" then
			c.waiting = waiting
			M.apply_obs("idle", nil, t)
		end
		return
	end
	I.clean = 0
	local want = STAT_STATE[main.stat]
	if not want then return end

	if c.state == "idle" or c.state == "ended" then
		if want == "ringing" then
			if main.dir ~= 1 then return end
			c = new_call("in", "ringing", main.number, t)
			I.seen_line = true
			emit({ type = "call_in", number = c.number, dir = "in" })
		elseif want == "dialing" or want == "alerting" then
			c = new_call("out", want, main.number, t)
			I.seen_line = true
		else
			-- 守护重启时通话已在进行: 直接接管,不补发 call_in
			c = new_call(main.dir == 1 and "in" or "out", "active", main.number, t)
			I.seen_line = true
			go_active(t)
		end
	elseif want == "ringing" and main.dir == 1 and (c.state == "active"
			or ((c.state == "dialing" or c.state == "alerting") and not (has_stat(calls, 2) or has_stat(calls, 3)))) then
		-- s101rel: 原通话已不在 CLCC 里(最高优先级的行是 stat=4)而新来电在响铃
		-- (呼叫等待在前一通挂断后转正): 先收尾上一通,再开新来电。以前 state 仍是 active 会一直卡住且不弹来电层。
		end_call(t)
		c = new_call("in", "ringing", main.number, t)
		I.seen_line = true
		emit({ type = "call_in", number = c.number, dir = "in" })
	else
		I.seen_line = true
		if want == "active" then
			if c.state ~= "active" then go_active(t) end
		elseif c.state == "ringing" then
			-- 振铃中只会变成 active 或消失,其他观测忽略
		elseif (c.state == "dialing" or c.state == "alerting") and (want == "dialing" or want == "alerting") then
			c.state = want
		end
		if c.number == "" and main.number ~= "" then c.number = main.number end
	end
	c.waiting = waiting
	c.held = held
	update_dur(t)
end

-- hint 行: "dial <号码> <uptime>" / "answer <uptime>" / "hangup <uptime>" / "ims <0|1> <uptime>"(s103)
function M.apply_hint(line, t)
	local verb, a, b = line:match("^(%a+)%s*(%S*)%s*(%S*)$")
	if not verb then return end
	local up = tonumber((verb == "dial" or verb == "ims") and b or a)
	if up and (t - up) > 30 then return end        -- 陈旧 hint 不理
	if verb == "dial" then
		if S.call.state == "idle" or S.call.state == "ended" then
			if a:match("^%+?%d+$") and #a <= 21 then
				new_call("out", "dialing", a, t)
			end
		end
	elseif verb == "ims" then
		-- s103: mwrt-phone-ctl 拨号前实时复核读到 IMS 已开(ims 1 <uptime>),经 hint 通道交给守护采纳。
		-- state.json 始终只由守护一个写者写,ctl 只追加 hint,不存在多写者竞态。只采纳 0/1。
		if a == "1" or a == "0" then
			local v = tonumber(a)
			if S.ims ~= v then S.ims = v end
			I.next_ims = t + ((v == 0) and C.ims_fast or C.ims_every)
		end
	elseif verb == "hangup" then
		I.hang_mono = t
	elseif verb == "answer" then
		I.ans_mono = t
	end
end

-- 每个循环调用: 定时器
function M.timers(t)
	local c = S.call
	if c.state == "ended" and (t - I.ended_mono) >= C.hold then
		S.call = blank_call()
		M.S = S
		return
	end
	if c.state == "ringing" or c.state == "dialing" or c.state == "alerting" or c.state == "active" then
		if (t - I.last_valid) >= C.stall then
			end_call(t, "unknown")
			S.health = "degraded"
		end
		update_dur(t)
	end
end

------------------------------------------------------------------ 短信

local function mark_seen(key)
	if I.seen[key] then return end
	I.seen[key] = true
	I.seen_list[#I.seen_list + 1] = key
	while #I.seen_list > C.seen_max do
		local old = table.remove(I.seen_list, 1)
		I.seen[old] = nil
	end
end

local function sms_key(m)
	local text = tostring(m.text or "")
	return tostring(m.sender or "") .. "|" .. tostring(m.dt or "") .. "|" .. #text .. "|" .. djb2(text)
end
M.sms_key = sms_key

-- 处理一轮 CMGL 解码结果。baseline=true 只记已见不发事件。返回新短信条数(含合并)。
function M.sms_consume(msgs, t, baseline)
	local fresh, seen_inc = {}, {}
	for _, m in ipairs(msgs) do
		local key = sms_key(m)
		if not I.seen[key] then
			local total = tonumber(m.total) or 1
			local nidx = (type(m.indices) == "table") and #m.indices or 1
			local complete = (total <= nidx)
			if baseline then
				mark_seen(key)
			elseif complete then
				fresh[#fresh + 1] = { m = m, partial = 0 }
				mark_seen(key)
			else
				local gk = tostring(m.sender or "") .. "|" .. tostring(m.ref or "") .. "|" .. tostring(m.dt or "")
				seen_inc[gk] = true
				local first = I.inc[gk]
				if not first then I.inc[gk] = t; first = t end
				if (t - first) >= C.partial then
					fresh[#fresh + 1] = { m = m, partial = 1 }
					mark_seen(key)
					I.inc[gk] = nil
				end
			end
		end
	end
	for gk in pairs(I.inc) do
		if not seen_inc[gk] then I.inc[gk] = nil end
	end

	if #fresh > C.sms_burst then
		emit({ type = "sms", sender = "", text = "收到 " .. #fresh .. " 条新短信", partial = 0 })
	else
		for _, f in ipairs(fresh) do
			local text = clip_text(f.m.text, 160)
			if f.partial == 1 then text = text .. "(内容不完整)" end
			local ev = emit({ type = "sms", sender = clip_text(f.m.sender, 40), text = text, partial = f.partial })
			ev.stat = tonumber(f.m.stat)       -- pdu_decoder 的 stat 原样记入(上板报告要看 CMGL 是否改了未读位)
		end
		if #fresh > 0 and I.persist then write_events() end
	end
	if I.persist then atomic_write(D .. "/sms.seen", table.concat(I.seen_list, "\n") .. "\n") end
	return #fresh
end

-- 最早的残缺组到期时间(没有则 nil)
local function inc_due()
	local due
	for _, first in pairs(I.inc) do
		local d = first + C.partial
		if not due or d < due then due = d end
	end
	return due
end

------------------------------------------------------------------ 在场/配置

function M.present()
	local mc = (nfs.readfile(MODCONF, 128) or ""):lower()
	if not mc:find("5700", 1, true) then return false end
	local it = nfs.dir(USBDIR)
	if not it then return false end
	for name in it do
		local v = nfs.readfile(USBDIR .. "/" .. name .. "/idVendor", 16)
		if v and trim(v) == "3466" then return true end
	end
	return false
end

local function read_cfg()
	local base = "uci " .. UCI_ARGS .. " -q get 'mwrt.@ndis[0].%s'"
	local cmd = string.format("{ " .. base .. "; echo '|'; " .. base .. "; echo '|'; " .. base .. "; }",
		"phone_note_sms", "phone_note_call", "phoneen")
	local out = runner(cmd)
	local a, b, c = out:match("^([^|]*)|([^|]*)|([^|]*)")
	if not a then return end
	S.cfg.sms = (trim(a) == "0") and 0 or 1
	S.cfg.call = (trim(b) == "0") and 0 or 1
	S.cfg.phoneen = (trim(c) == "0") and 0 or 1
end

local function seen_recently(t)
	if t - I.seen_cache_t < 1 then return I.seen_cache end
	I.seen_cache_t = t
	local mt = nfs.stat(D .. "/seen", "mtime")
	I.seen_cache = (mt ~= nil) and (math.abs(os.time() - mt) <= C.seen_win)
	return I.seen_cache
end

------------------------------------------------------------------ AT 调用(只读)

local function at_read(cmd, tmo)
	local sp = sendat_path()
	local t0 = mono()
	local out = runner(string.format("timeout 5 %s 1 %s %d", shq(sp), shq(cmd), tmo or 2))
	I.at_total = I.at_total + 1
	I.at_ms = (I.at_ms or 0) + math.floor((mono() - t0) * 1000)       -- 累计耗时(毫秒),写进 stats.json 供测量
	return out
end

-- other=true: CPMS/CMGL/IMS 的结果,单独记连败,不影响 CLCC 的退避与 health
-- (否则 CLCC 一直被污染而 CPMS 偶尔成功时,"任一次有效回包即复位"会把退避和 degraded 反复冲掉)。
local function note_result(valid, other)
	if other then
		if valid then
			I.ofails = 0
		else
			I.ofails = I.ofails + 1
			I.at_fail = I.at_fail + 1
		end
		return
	end
	if valid then
		I.fails = 0
		if S.health == "degraded" then S.health = "ok" end
	else
		I.fails = I.fails + 1
		I.at_fail = I.at_fail + 1
		if I.fails >= 2 then S.health = "degraded" end
	end
end

local function clcc_interval(t)
	if S.call.state ~= "idle" then return math.min(C.call, C.call_max) end
	local base = seen_recently(t) and C.idle_seen or C.idle_unseen
	if I.fails >= 4 then return math.max(base, C.bo2) end
	if I.fails >= 2 then return math.max(base, C.bo1) end
	return base
end

local function poll_clcc()
	local out = at_read("AT+CLCC", 2)
	local kind, calls = M.parse_clcc(out)
	local t = mono()
	if kind == "unknown" then
		note_result(false)
	else
		note_result(true)
		M.apply_obs(kind, calls, t)
	end
	I.next_clcc = t + clcc_interval(t)
end

local function sms_read(t)
	local sp = sendat_path()
	local pipeline = shq(sp) .. " 1 at+cmgl=4 12 | " .. shq(PDU) .. " --json"
	local out = runner("timeout 15 sh -c " .. shq(pipeline))
	I.at_total = I.at_total + 1
	local dec = jsonc.parse(out)
	if type(dec) ~= "table" or dec.ok ~= true or type(dec.messages) ~= "table" then
		note_result(false, true)
		-- s101rel: 读短信失败按 30/60/120/…/600 秒退避。以前固定 30 秒,SIM 里短信多到 CMGL 读不完时
		-- 会每 30 秒占 AT 口最多 15 秒,而且永远不会停。
		I.sms_fails = (I.sms_fails or 0) + 1
		I.next_sms_retry = t + math.min(C.sms_retry * (2 ^ math.min(I.sms_fails - 1, 5)), 600)
		return false
	end
	I.sms_fails = 0
	note_result(true, true)
	M.sms_consume(dec.messages, t, not I.baseline_done)
	I.baseline_done = true
	I.last_used = S.sms.used
	I.next_full = t + (seen_recently(t) and C.full_seen or C.full_unseen)
	return true
end

local function poll_cpms(t)
	local out = at_read("AT+CPMS?", 2)
	local r = M.parse_cpms(out)
	t = mono()
	I.next_cpms = t + (seen_recently(t) and C.cpms_seen or C.cpms_unseen)
	if not r then
		note_result(false, true)
		if I.ofails >= 2 then I.next_cpms = t + math.max(C.bo1, I.next_cpms - t) end
		return
	end
	note_result(true, true)
	S.sms.used, S.sms.total, S.sms.mem = r.used, r.total, r.mem
	S.sms.full = (r.total > 0 and r.used >= r.total) and 1 or 0
	if t < I.next_sms_retry then return end
	local due = inc_due()
	local need = (not I.baseline_done) or (I.last_used ~= r.used) or (t >= I.next_full) or (due and t >= due)
	if not need then return end
	if not I.baseline_done and r.used == 0 then
		-- 空卡基线: 不需要 CMGL
		I.baseline_done = true
		I.last_used = 0
		I.next_full = t + (seen_recently(t) and C.full_seen or C.full_unseen)
		return
	end
	sms_read(t)
end

local function poll_ims(t)
	local out = at_read("AT^IMSSWITCH?", 2)
	local v = M.parse_ims(out)
	if v then
		S.ims = v
		note_result(true, true)
	else
		note_result(false, true)
	end
	-- s103: ims=0 时 30 秒复查一次(只读 AT^IMSSWITCH?),开了(1)或未知(-1)恢复 300 秒
	I.next_ims = mono() + ((S.ims == 0) and C.ims_fast or C.ims_every)
end

------------------------------------------------------------------ 写状态

local function build_state(t)
	update_dur(t)
	local c = S.call
	local sp, via = sendat_path()
	return {
		v = 1, supported = S.supported, fake = (via ~= "real") and 1 or 0, gen = S.gen,
		ts = os.time(), seq = S.seq, health = S.health, ims = S.ims,
		cfg = { sms = S.cfg.sms, call = S.cfg.call },
		call = { state = c.state, dir = c.dir, number = c.number, cid = c.cid, waiting = c.waiting,
			held = c.held, ring_ts = c.ring_ts, active_ts = c.active_ts, end_ts = c.end_ts,
			dur = c.dur, answered = c.answered, reason = c.reason, silent = c.silent },
		sms = { used = S.sms.used, total = S.sms.total, mem = S.sms.mem, full = S.sms.full },
	}
end
M.build_state = build_state

local function write_state(t, force)
	local sig = touch_sig()
	local incall = S.call.state ~= "idle"
	if force or incall or sig ~= I.sig or (t - I.last_write) >= C.heartbeat then
		if I.persist then
			atomic_write(D .. "/state.json", jsonc.stringify(build_state(t)) .. "\n")
		end
		I.sig, I.last_write = sig, t
	end
	-- 调用统计(排查/测量用)独立计时,每 heartbeat 秒写一次,不受 state 写入节奏影响
	if I.persist and (t - (I.last_stats or -1000)) >= C.heartbeat then
		atomic_write(D .. "/stats.json", jsonc.stringify({ at_total = I.at_total, at_ms = I.at_ms or 0, at_fail = I.at_fail,
			fails = I.fails, ofails = I.ofails, up = math.floor(t) }) .. "\n")
		I.last_stats = t
	end
end

------------------------------------------------------------------ 主循环一步

local function boot_uptime(t0, t)
	local o = tonumber(os.getenv("MWRT_PHONE_BOOT_UPTIME") or "")
	if o then return o + (t - t0) end
	return t
end

local function take_hints(t)
	local h = D .. "/hint"
	if not nfs.stat(h, "type") then return end
	local p = h .. ".proc"
	if not nfs.rename(h, p) then return end
	local data = nfs.readfile(p, 4096) or ""
	nfs.remove(p)
	for line in data:gmatch("[^\n]+") do M.apply_hint(trim(line), t) end
end

function M.step(t, t0)
	take_hints(t)
	M.timers(t)

	if t >= I.next_cfg then
		read_cfg()
		I.next_cfg = t + C.cfg_every
		if S.call.state == "ringing" then S.call.silent = (S.cfg.call == 0) and 1 or 0 end
	end

	if t >= I.next_recheck then
		local was = S.supported
		S.supported = M.present() and S.cfg.phoneen ~= 0
		I.next_recheck = t + C.recheck
		if was and not S.supported and S.call.state ~= "idle" and S.call.state ~= "ended" then
			end_call(t, "unknown")
		end
		if S.supported and not was then I.next_clcc, I.next_cpms, I.next_ims = 0, 0, 0 end
	end

	if not S.supported then
		S.health = "ok"
		write_state(t)
		return
	end

	if boot_uptime(t0, t) < C.boot then
		S.health = "booting"
		write_state(t)
		return
	end
	if S.health == "booting" then S.health = "ok" end

	if nfs.stat(RMLOCK, "type") then
		S.health = "busy"
		write_state(t)
		return
	elseif S.health == "busy" then
		S.health = "ok"
	end

	local force = false
	if t >= I.next_clcc then
		poll_clcc()
		force = true
		t = mono()
	end
	-- 刚轮询完 CLCC 的这一步不再发别的 AT,留给下一个循环; 通话态让位,不做短信/IMS
	if S.call.state == "idle" and not force then
		if S.cfg.sms == 1 and t >= I.next_cpms then
			poll_cpms(t)
		elseif t >= I.next_ims then
			poll_ims(t)
		elseif S.cfg.sms == 1 and I.baseline_done and t >= I.next_sms_retry and inc_due() and t >= inc_due() then
			sms_read(t)
		end
		t = mono()
	end
	write_state(t, force)
end

------------------------------------------------------------------ 入口

local function main()
	nfs.mkdirr(D)
	local lk = nixio.open(D .. "/daemon.lock", "w")
	if not lk or not lk:lock("tlock") then
		io.stderr:write("mwrt-phoned: 已有实例在运行,退出\n")
		os.exit(3)
	end
	M._lockfile = lk          -- 持有到进程结束
	M.reset(true)
	S.seq = read_int_file(D .. "/seq", 0)
	I.cidn = read_int_file(D .. "/cid", 0)
	write_events()
	local t0 = mono()
	write_state(t0, true)
	while true do
		local ok, err = pcall(M.step, mono(), t0)
		if not ok then
			io.stderr:write("mwrt-phoned: 步进异常: " .. tostring(err) .. "\n")
			S.health = "degraded"
			sleep_s(1)
		end
		sleep_s(C.loop)
	end
end

if os.getenv("MWRT_PHONE_LIB") == "1" then
	-- 单元测试钩子: 只返回函数表,不进入主循环
	M.reset(false)
	M._poll_clcc, M._poll_cpms, M._sms_read, M._poll_ims = poll_clcc, poll_cpms, sms_read, poll_ims
	return M
end

main()
