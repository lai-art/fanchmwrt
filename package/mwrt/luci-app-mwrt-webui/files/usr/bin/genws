#!/usr/bin/lua
-- genws: 通用模组 WEBUI 的轻量后端(Lua + nixio)。
--
-- 前端是 5700 那套 SPA 的独立副本(/www/gen),它只会说「华为 AT」。本后端让它在任意 QModem 管理的模组上工作:
--   * WebSocket 协议和 5700 的 webuiserver 一致:收原始 AT 文本(尾部 \r)、"ping" 回 "pong",
--     回 {"success":true,"data":"<回包>\r\n\r\nOK"} / {"success":false,"data":..,"error":..}
--   * 通用 3GPP 指令(CSQ/CREG/COPS/CGDCONT/CFUN/CMGL/CMGS...)直接经 sendat 垫片发给模组(和 qmodem 的 at-daemon 错开 + 串线重发)
--   * 华为私有的「读」指令(^HCSQ/^MONSC/^DSFLOWQRY/^HFREQINFO/^CHIPTEMP/^EONS/^ICCID/^DHCP...)用 QModem 的数据合成:
--       ubus qmodem cell_info/base_info/sim_info/network_info 由后台子进程定时刷到 /tmp/genws/*.json,
--       主进程只读文件,绝不阻塞;新结果为空(AT 口被占)时保留上一份(粘滞)
--   * 其余华为私有指令回 ERROR(前端按失败处理)
-- 用法:genws [端口]   默认 8766(通用模组时 350/520/5700 的后端都不在,不冲突)

local nixio = require "nixio"
local ubus  = require "ubus"
local json  = require "luci.jsonc"
local bit   = nixio.bit
local band, bor, bxor, rshift = bit.band, bit.bor, bit.bxor, bit.rshift

pcall(nixio.signal, 15, "dfl")
pcall(nixio.signal, 13, "ign")

local SHIM   = "/usr/share/modem/webuiserver-shim"
local CACHE  = "/tmp/genws"
local CFGWEB = "/www/gen/config.json"
local M32    = 4294967296
local MAXMSG = 1048576
local MAXCLI = 12
local PORT   = tonumber(arg and arg[1]) or 8766

-- ---------- 基础工具 ----------
local function readfile(p)
	local f = io.open(p, "r"); if not f then return nil end
	local s = f:read("*a"); f:close(); return s
end
local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
local function shq(s) return "'" .. (s:gsub("'", "'\\''")) .. "'" end
local function now() return os.time() end

-- 这版 Lua 的 string.format("%X") 不吃 >= 2^31 的整数
local function hexs(n)
	n = math.floor(tonumber(n) or 0)
	if n <= 0 then return "0" end
	local t = {}
	while n > 0 do
		local d = n % 16
		t[#t + 1] = string.sub("0123456789ABCDEF", d + 1, d + 1)
		n = (n - d) / 16
	end
	return string.reverse(table.concat(t))
end
local function hex8(n) return string.rep("0", 8 - #hexs(n)) .. hexs(n) end

-- ---------- SHA1 + base64(WebSocket 握手用) ----------
local function rol(x, n)
	local d = 2 ^ (32 - n)
	return (x % d) * 2 ^ n + math.floor(x / d)
end
local function sha1(msg)
	local h0, h1, h2, h3, h4 = 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0
	local ml = #msg * 8
	msg = msg .. "\128" .. string.rep("\0", (55 - #msg) % 64) ..
		string.char(0, 0, 0, 0, band(rshift(ml, 24), 255), band(rshift(ml, 16), 255), band(rshift(ml, 8), 255), band(ml, 255))
	for c = 1, #msg, 64 do
		local w = {}
		for i = 0, 15 do
			local a, b, cc, d = msg:byte(c + i * 4, c + i * 4 + 3)
			w[i] = a * 16777216 + b * 65536 + cc * 256 + d
		end
		for i = 16, 79 do w[i] = rol(bxor(bxor(w[i - 3], w[i - 8]), bxor(w[i - 14], w[i - 16])), 1) end
		local a, b, cc, d, e = h0, h1, h2, h3, h4
		for i = 0, 79 do
			local f, k
			if i < 20 then f = bor(band(b, cc), band(bxor(b, 0xffffffff), d)); k = 0x5A827999
			elseif i < 40 then f = bxor(bxor(b, cc), d); k = 0x6ED9EBA1
			elseif i < 60 then f = bor(bor(band(b, cc), band(b, d)), band(cc, d)); k = 0x8F1BBCDC
			else f = bxor(bxor(b, cc), d); k = 0xCA62C1D6 end
			local t = (rol(a, 5) + f + e + k + w[i]) % M32
			e = d; d = cc; cc = rol(b, 30); b = a; a = t
		end
		h0 = (h0 + a) % M32; h1 = (h1 + b) % M32; h2 = (h2 + cc) % M32; h3 = (h3 + d) % M32; h4 = (h4 + e) % M32
	end
	local hex = {}
	for _, v in ipairs({ h0, h1, h2, h3, h4 }) do hex[#hex + 1] = string.format("%04x%04x", math.floor(v / 65536), v % 65536) end
	return nixio.bin.unhexlify(table.concat(hex))
end
local function accept_key(key)
	return nixio.bin.b64encode(sha1(key .. "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
end

-- ---------- 子进程 / socket 状态 ----------
local lsock, clients = nil, {}
local function child_close_fds()
	pcall(function() lsock:close() end)
	for _, c in ipairs(clients) do pcall(function() c.sock:close() end) end
end

-- ---------- QModem 数据源(后台子进程刷新,主进程只读文件) ----------
os.execute("mkdir -p " .. CACHE)

local section, netdev            -- QModem 的 config_section(如 2_1)和拨号网卡(如 wwan0)
local sec_checked = 0
local function find_section()
	if section and now() - sec_checked < 60 then return end
	sec_checked = now()
	local p = io.popen("uci -q show qmodem 2>/dev/null")
	if not p then return end
	local out = p:read("*a") or ""; p:close()
	local first, pick
	for sname in out:gmatch("\nqmodem%.([%w_]+)=modem%-device") do
		first = first or sname
		if out:find("qmodem%." .. sname .. "%.state='enabled'") then pick = pick or sname end
	end
	if out:match("^qmodem%.([%w_]+)=modem%-device") then
		local s0 = out:match("^qmodem%.([%w_]+)=modem%-device")
		first = first or s0
		if not pick and out:find("qmodem%." .. s0 .. "%.state='enabled'") then pick = s0 end
	end
	section = pick or first
	if section then netdev = out:match("qmodem%." .. section .. "%.network='([^']+)'") end
end

-- name -> {method, ttl 秒, 子进程 pid, 上次启动时间}
local SRC = {
	cell = { method = "cell_info",    ttl = 4 },
	base = { method = "base_info",    ttl = 20 },
	sim  = { method = "sim_info",     ttl = 60 },
	net  = { method = "network_info", ttl = 30 },
}
local function src_file(k) return CACHE .. "/" .. k .. ".json" end

local function reap()
	for _, s in pairs(SRC) do
		if s.pid then
			local r = nixio.waitpid(s.pid, "nohang")
			if r then s.pid = nil end
		end
	end
end

local function spawn_refresh(k, s)
	local f, tmp = src_file(k), src_file(k) .. ".tmp"
	local cmd = string.format("timeout -s KILL 40 ubus call qmodem %s %s > %s 2>/dev/null; " ..
		"if grep -q '\"key\"' %s 2>/dev/null; then mv -f %s %s; else rm -f %s; fi",
		s.method, shq('{"config_section":"' .. section .. '"}'), tmp, tmp, tmp, f, tmp)
	local pid = nixio.fork()
	if pid == 0 then
		child_close_fds()
		nixio.exec("/bin/sh", "-c", cmd)
		os.exit(1)
	end
	s.pid = pid; s.t = now()
end

local last_active = 0          -- 最近有人用就保持刷新;没人用时不打扰 AT 口
local function tick()
	reap()
	if now() - last_active > 120 then return end
	find_section()
	if not section then return end
	for k, s in pairs(SRC) do
		if not s.pid and (not s.t or now() - s.t >= s.ttl) then spawn_refresh(k, s) end
	end
end

local function qm(k)
	local d = readfile(src_file(k))
	local j = d and json.parse(d)
	local list = {}
	if type(j) == "table" and type(j.modem_info) == "table" then list = j.modem_info end
	return list
end
-- 平铺成 key -> value(同名取第一个);base/sim/net 这类「某次少几项」的来源按键粘滞:新值覆盖,缺的沿用上一次
local run_at   -- 前向声明(下面的合成指令要用)
local sticky = {}
local function kvm(k)
	local m = sticky[k] or {}
	sticky[k] = m
	for _, e in ipairs(qm(k)) do
		if e.key and e.value ~= nil and e.value ~= "" then
			m[e.key] = e.value
		end
	end
	return m
end
local function kv(list)
	local m = {}
	for _, e in ipairs(list) do
		if e.key and m[e.key] == nil then m[e.key] = e.value end
	end
	return m
end

-- 按「当前制式」把 cell_info 切成 {nr=..., lte=..., mode=...}。
-- QModem 的格式:network_mode 先给整体制式;NSA 时依次出现 key=LTE / key=NR5G-NSA 的分段标记,后面跟该制式的字段。
local function split_cells()
	local list = qm("cell")
	local cur, res = nil, { nr = nil, lte = nil, other = nil, mode = "" }
	local mode = ""
	for _, e in ipairs(list) do
		if e.key == "network_mode" then mode = tostring(e.value or "") end
	end
	res.mode = mode
	local um = mode:upper()
	if um:find("NR5G") and not um:find("NSA") and not um:find("EN") then cur = "nr"
	elseif um:find("LTE") and not um:find("NR") then cur = "lte"
	elseif um:find("WCDMA") or um:find("UMTS") or um:find("GSM") then cur = "other"
	else cur = "lte" end
	res[cur] = {}
	for _, e in ipairs(list) do
		if e.key == "LTE" and e.value == "LTE" then res.lte = res.lte or {}; cur = "lte"
		elseif e.key == "NR5G-NSA" then res.nr = res.nr or {}; cur = "nr"
		elseif e.key ~= "network_mode" then
			res[cur] = res[cur] or {}
			if res[cur][e.key] == nil then res[cur][e.key] = e.value end
		end
	end
	return res
end

local function num(v)
	if v == nil then return nil end
	local n = tostring(v):match("^%s*(-?%d+%.?%d*)")
	return n and tonumber(n) or nil
end
local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function round(x) return math.floor(x + 0.5) end

-- ---------- 频点 -> 频率 ----------
local LTE_BANDS = {   -- band = {FDL_low(MHz), NOffs-DL}
	[1] = { 2110, 0 }, [2] = { 1930, 600 }, [3] = { 1805, 1200 }, [4] = { 2110, 1950 }, [5] = { 869, 2400 },
	[7] = { 2620, 2750 }, [8] = { 925, 3450 }, [12] = { 729, 5010 }, [13] = { 746, 5180 }, [17] = { 734, 5730 },
	[18] = { 860, 5850 }, [19] = { 875, 6000 }, [20] = { 791, 6150 }, [25] = { 1930, 8040 }, [26] = { 859, 8690 },
	[28] = { 758, 9210 }, [34] = { 2010, 36200 }, [38] = { 2570, 37750 }, [39] = { 1880, 38250 }, [40] = { 2300, 38650 },
	[41] = { 2496, 39650 }, [42] = { 3400, 41590 }, [43] = { 3600, 43590 }, [66] = { 2110, 66436 }, [71] = { 617, 68586 },
}
local function nr_khz(n)
	if n < 600000 then return 5 * n
	elseif n < 2016667 then return 3000000 + 15 * (n - 600000)
	else return 24250080 + 60 * (n - 2016667) end
end

-- ---------- 华为指令合成 ----------
local function iface_status(name)
	local ok, r = pcall(function()
		local c = ubus.connect(); if not c then return nil end
		local x = c:call("network.interface." .. name, "status", {})
		c:close()
		return x
	end)
	return ok and r or nil
end

local function ip4hex(a)   -- 华为 ^DHCP 的 IP 是小端 hex
	local o = { a:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$") }
	if #o ~= 4 then return "00000000" end
	return string.format("%02X%02X%02X%02X", o[4], o[3], o[2], o[1])
end
local function mask_from_prefix(p)
	local v = 0
	for i = 0, 31 do if i < p then v = v + 2 ^ (31 - i) end end
	return string.format("%d.%d.%d.%d", math.floor(v / 16777216) % 256, math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256)
end

local flow_base, sess_t0 = nil, nil
local function read_stat(dev, f)
	local s = readfile("/sys/class/net/" .. dev .. "/statistics/" .. f)
	return s and tonumber(trim(s)) or 0
end

local function plmn_of(c)
	local m = qm("cell")
	local k = kv(m)
	local mcc, mnc = k.MCC, k.MNC
	if mcc and mnc then return (tostring(mcc):gsub("%D", "")) .. (tostring(mnc):gsub("%D", "")) end
	local imsi = kvm("sim").IMSI
	if imsi and #imsi >= 5 then return imsi:sub(1, 5) end
	return nil
end

local syn = {}

syn["AT^HCSQ?"] = function()
	local c = split_cells()
	local lines = {}
	local function rsrp_raw(v) return v <= -140 and 0 or (v >= -44 and 97 or round(v + 140)) end
	local function sinr_raw(v) return v <= -20 and 0 or (v >= 30 and 251 or round((v + 20) / 0.2)) end
	if c.nr and num(c.nr.RSRP) then
		local rq = num(c.nr.RSRQ) or -20
		lines[#lines + 1] = string.format('^HCSQ: "NR",%d,%d,%d', rsrp_raw(num(c.nr.RSRP)),
			sinr_raw(num(c.nr.SINR) or -20), clamp(round((rq + 43) * 2), 0, 127))
	end
	if c.lte and num(c.lte.RSRP) then
		local rssi = num(c.lte.RSSI) or -120
		local rq = num(c.lte.RSRQ) or -20
		lines[#lines + 1] = string.format('^HCSQ: "LTE",%d,%d,%d,%d', clamp(round(rssi + 121), 0, 96), rsrp_raw(num(c.lte.RSRP)),
			sinr_raw(num(c.lte.SINR) or -20), clamp(round((rq + 19.5) / 0.5), 0, 34))
	end
	if #lines == 0 then return '^HCSQ: "NOSERVICE"' end
	return table.concat(lines, "\r\n")
end

syn["AT^MONSC"] = function()
	local c = split_cells()
	local function pcihex(v) local n = num(v); return n and hexs(n) or "0" end
	local function plmn(m) return (tostring(m.MCC or "460"):gsub("%D", "")), (tostring(m.MNC or "00"):gsub("%D", "")) end
	if c.nr and c.nr.ARFCN and (c.nr.RSRP or c.nr["Physical Cell ID"]) then
		local m = c.nr
		local mcc, mnc = plmn(m)
		local kv0 = kv(qm("cell"))
		return string.format("^MONSC: NR,%s,%s,%s,%s,%s,%s,%s,%d,%d,%d", mcc, mnc, tostring(m.ARFCN), tostring(num(m.SCS) or 0),
			(tostring(m["Cell ID"] or kv0["Cell ID"] or "0"):gsub("[^%x]", "")), pcihex(m["Physical Cell ID"]),
			(tostring(m.TAC or kv0.TAC or "0"):gsub("[^%x]", "")), num(m.RSRP) or -140, num(m.RSRQ) or -20, num(m.SINR) or -20)
	elseif c.lte and c.lte.ARFCN then
		local m = c.lte
		local mcc, mnc = plmn(m)
		return string.format("^MONSC: LTE,%s,%s,%s,%s,%s,%s,%d,%d,%d", mcc, mnc, tostring(m.ARFCN),
			(tostring(m["Cell ID"] or "0"):gsub("[^%x]", "")), pcihex(m["Physical Cell ID"]),
			(tostring(m.TAC or "0"):gsub("[^%x]", "")), num(m.RSRP) or -140, num(m.RSRQ) or -20, num(m.SINR) or -20)
	end
	return nil
end

syn["AT^DSFLOWQRY"] = function()
	find_section()
	local dev = netdev or "wwan0"
	local tx, rx = read_stat(dev, "tx_bytes"), read_stat(dev, "rx_bytes")
	if not flow_base then flow_base = { tx = 0, rx = 0 } end
	if not sess_t0 then sess_t0 = now() end
	local ttx, trx = math.max(0, tx - flow_base.tx), math.max(0, rx - flow_base.rx)
	local dur = now() - sess_t0
	return string.format("^DSFLOWQRY: %s,%s,%s,%s,%s,%s", hexs(dur), hexs(ttx), hexs(trx), hexs(dur), hexs(ttx), hexs(trx))
end
syn["AT^DSFLOWCLR"] = function()
	find_section()
	local dev = netdev or "wwan0"
	flow_base = { tx = read_stat(dev, "tx_bytes"), rx = read_stat(dev, "rx_bytes") }
	sess_t0 = now()
	return ""
end

syn["AT^HFREQINFO?"] = function()
	local c = split_cells()
	local parts, n = {}, 0
	local function add(is_nr, m)
		local band_n = num(m.Band)
		local ar = num(m.ARFCN)
		if not band_n or not ar then return end
		local freq   -- NR: kHz(前端 *0.001 得 MHz);LTE: 100kHz(前端 *0.1 得 MHz)
		if is_nr then freq = nr_khz(ar)
		else
			local t = LTE_BANDS[band_n]
			freq = t and round((t[1] + 0.1 * (ar - t[2])) * 10) or 0
		end
		local bw = (num(m["DL Bandwidth"]) or 0) * 1000
		n = n + 1
		parts[#parts + 1] = string.format("^HFREQINFO: 0,%d,%d,%d,%d,%d,%d,%d,%d", is_nr and 7 or 6, band_n, ar, freq, bw, ar, freq, bw)
	end
	if c.nr then add(true, c.nr) end
	if c.lte then add(false, c.lte) end
	if n == 0 then return nil end
	return table.concat(parts, "\r\n")
end

syn["AT^CHIPTEMP?"] = function()
	local t = num(kvm("base").temperature)
	if not t then return nil end
	local v = round(t * 10)
	return string.format("^CHIPTEMP: %d,%d,%d,%d,%d,%d,%d,65535", v, v, v, v, v, v, v)
end

syn["AT^EONS=2"] = function()
	local p = plmn_of()
	if not p then return nil end
	return string.format('^EONS: 2,"%s",0,0', p)
end

syn["AT^ICCID?"] = function()
	local v = kvm("sim").ICCID
	if not v or v == "" then
		-- QModem 还没给出(sim_info 偶发空):各家 ICCID 指令依次试一遍(只读)
		for _, c in ipairs({ "AT+QCCID", "AT+CCID", "AT+ICCID" }) do
			local o = run_at(c)
			v = o and o:match("(%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d%d?%d?)")
			if v then break end
		end
	end
	if not v or v == "" then return nil end
	return "^ICCID: " .. v
end

syn["AT^DHCP?"] = function()
	find_section()
	if not section then return nil end
	local s = iface_status(section)
	local a = s and s["ipv4-address"] and s["ipv4-address"][1]
	if not a then return nil end
	local gw
	for _, r in ipairs(s.route or {}) do if r.target == "0.0.0.0" then gw = r.nexthop end end
	local dns = s["dns-server"] or {}
	return string.format("^DHCP: %s,%s,%s,%s,%s,%s,0,0", ip4hex(a.address), ip4hex(mask_from_prefix(a.mask or 32)),
		ip4hex(gw or "0.0.0.0"), ip4hex(gw or "0.0.0.0"), ip4hex(dns[1] or "0.0.0.0"), ip4hex(dns[2] or "0.0.0.0"))
end
syn["AT^DHCPV6?"] = function()
	find_section()
	if not section then return nil end
	local s = iface_status(section .. "v6")
	local a = s and ((s["ipv6-address"] and s["ipv6-address"][1]) or (s["ipv6-prefix-assignment"] and s["ipv6-prefix-assignment"][1]))
	if not a then return nil end
	local dns = s["dns-server"] or {}
	return string.format("^DHCPV6: %s,,,,%s,%s,0,0", a.address or "::", dns[1] or "", dns[2] or "")
end

syn["AT^IPV6CAP?"] = function() return "^IPV6CAP: 7" end

syn["AT^DSAMBR=1"] = function()
	local k = kvm("net")
	local ul, dl = num(k["AMBR UL"]), num(k["AMBR DL"])
	if not ul and not dl then return nil end
	return string.format('^DSAMBR: 1,%d,%d,"ims"', (dl or 0) * 1000, (ul or 0) * 1000)
end
syn["AT^DSAMBR=8"] = syn["AT^DSAMBR=1"]

-- ---------- AT 通路(sendat 垫片) ----------
local function crossed(cmd, out)
	local first = out:match("^([^\n]*)")
	if first ~= nil and first:upper():sub(1, 2) == "AT" and first:upper() ~= cmd:upper() then return true end
	local name = cmd:upper():match("^AT(%+[%w]+)%?$") or cmd:upper():match("^AT(%+[%w]+)$")
	if name then
		local got = out:upper():match("^(%+[%w]+):") or out:upper():match("\n(%+[%w]+):")
		if got and got ~= name then return true end
	end
	return false
end

function run_at(cmd)
	cmd = trim(cmd)
	local safe = not cmd:find("=", 1, true) or cmd:sub(-1) == "?"
	local t0, out = now(), ""
	for _ = 1, 5 do
		local p = io.popen("PATH=" .. SHIM .. ":$PATH sendat 1 " .. shq(cmd) .. " 4 2>&1")
		out = p and p:read("*a") or ""
		if p then p:close() end
		out = trim((out:gsub("\r", "")))
		if not crossed(cmd, out) then break end
		if not safe or now() - t0 >= 7 then return nil end
	end
	if crossed(cmd, out) then return nil end
	local first, rest = out:match("^([^\n]*)\n(.*)$")
	if first and first:upper() == cmd:upper() then out = trim(rest) end
	if out == "" or out:upper() == cmd:upper() then return nil end
	return out
end

-- ---------- 发短信:AT+CMGS=<len>\r<PDU> ----------
local function lock_at()
	if not nixio.fs.access("/tmp/sendat.at.lock") then
		local f = io.open("/tmp/sendat.at.lock", "a"); if f then f:close() end
	end
	local rd, wr = nixio.pipe()
	if not rd then return nil end
	local child = nixio.fork()
	if child == 0 then
		rd:close()
		child_close_fds()
		nixio.dup(wr, nixio.stdout)
		nixio.exec("/usr/bin/flock", "/tmp/sendat.at.lock", "sh", "-c", "echo $$; exec sleep 30")
		os.exit(1)
	end
	wr:close()
	local held
	local p = { { fd = rd, events = nixio.poll_flags("in") } }
	if child and nixio.poll(p, 6000) > 0 then held = tonumber((rd:read(32) or ""):match("%d+")) end
	rd:close()
	if held then return { child = child, sleeper = held } end
	if child then nixio.kill(child, 15); nixio.waitpid(child) end
	return nil
end
local function unlock_at(h)
	if not h then return end
	nixio.kill(h.sleeper, 15)
	nixio.waitpid(h.child)
end

local conn
local function ubus_call(obj, method, msg)
	if not conn then conn = ubus.connect() end
	if not conn then return nil end
	local r = conn:call(obj, method, msg or {})
	if not r then conn = nil end
	return r
end
local function at_port()
	local r = ubus_call("at-daemon", "list")
	if r and r.ports and r.ports[1] and r.ports[1].port then return r.ports[1].port end
	return "/dev/ttyUSB2"
end

local function send_pdu(len, pdu)
	local port = at_port()
	local function at(args, tmo)
		args.at_port = port; args.timeout = tmo
		return ubus_call("at-daemon", "sendat", args)
	end
	local function esc()
		local f = nixio.open(port, "w")
		if f then f:write("\27"); f:close() end
	end
	local holder = lock_at()
	local ok, err
	repeat
		local r
		for _ = 1, 3 do
			r = at({ at_cmd = "AT+CMGF=0" }, 3)
			local rs = r and r.response or ""
			if rs:find("OK", 1, true) and not crossed("AT+CMGF=0", trim((rs:gsub("\r", "")))) then break end
			r = nil
		end
		if not r then err = "AT+CMGF=0 未返回OK"; break end
		r = at({ at_cmd = "AT+CMGS=" .. len, sendonly = true }, 2)
		if not (r and r.status == "success") then esc(); err = "未收到 > 提示符，模块无响应"; break end
		nixio.nanosleep(0, 800000000)
		r = at({ raw_at_content = pdu .. "\26" }, 12)
		local resp = r and (r.response or r.partial_response) or ""
		if resp:find("+CMGS:", 1, true) then ok = resp
		elseif resp:find("+CMS ERROR", 1, true) then err = resp
		else esc(); err = "发送失败：" .. resp end
	until true
	unlock_at(holder)
	return ok, err
end

-- ---------- 指令分发 ----------
local function fail(msg) return { success = false, data = "ERROR", error = msg or "ERROR" } end
local function okres(body)
	body = body and trim(body) or ""
	if body == "" then return { success = true, data = "\r\n\r\nOK" } end
	return { success = true, data = body .. "\r\n\r\nOK" }
end

-- 标准指令里这几条的回包由 QM 兜底(模组不回/串线时)
local function qm_fallback(cmd)
	local u = cmd:upper()
	if u == "AT+CGSN" then
		local v = kvm("sim").IMEI; return v and v ~= "" and (v .. "") or nil
	elseif u == "AT+CGMR" then
		local v = kvm("base").revision; return v and ("+CGMR: " .. v) or nil
	elseif u == "AT+CIMI" then
		local v = kvm("sim").IMSI; return v and v ~= "" and v or nil
	elseif u == "AT+CPIN?" then
		local v = tostring(kvm("sim")["SIM Status"] or ""):lower()
		if v == "ready" then return "+CPIN: READY" end
	end
	return nil
end

local function exec_at(cmd)
	local u = cmd:upper()

	-- 发短信(整段一条:AT+CMGS=<len> 后面跟 \r 或字面 \r 再接 PDU)
	local len, pdu = cmd:match("^[Aa][Tt]%+[Cc][Mm][Gg][Ss]=(%d+)\\r(%x+)$")
	if not len then len, pdu = cmd:match("^[Aa][Tt]%+[Cc][Mm][Gg][Ss]=(%d+)[\r\n]+(%x+)$") end
	if len then
		local ok, err = send_pdu(len, pdu)
		if ok then return okres(ok) end
		return fail(err)
	end

	if syn[u] then
		local r = syn[u]()
		if r == nil then
			-- 缓存还没有(刚启动/AT 口被占):这条不当成功,前端会保留上一轮的值
			return fail("暂无数据")
		end
		return okres(r)
	end

	-- 网络时间:模组自己的 +CCLK 转成华为的 ^NWTIME 格式
	if u == "AT^NWTIME?" then
		local o = run_at("AT+CCLK?")
		local t = o and o:match('%+CCLK:%s*"([^"]+)"')
		if t and not t:match("^0[0-9]/") and not t:match("^70/") then return okres("^NWTIME: " .. t) end
		return fail("模组无网络时间")
	end

	-- 华为私有指令(^ 开头,以及 +WEBHOOK/+CEUS 这类 5700 私货):通用模组不支持
	if u:match("^AT%^") or u:match("^AT%+WEBHOOK") or u:match("^AT%+CEUS") then return fail("该模组不支持此指令") end

	-- 这几条 QModem 已经有:优先用它的(不去和 qmodem 的 AT 轮询抢串口,也避开回包串线)
	local fb = qm_fallback(cmd)
	if fb then return okres(fb) end
	local o = run_at(cmd)
	if not o then return fail("无返回") end
	if o:find("ERROR", 1, true) and not o:find("OK", 1, true) then
		return { success = false, data = o, error = o }
	end
	o = trim((o:gsub("\nOK$", ""):gsub("^OK$", "")))
	return okres(o)
end

local function handle(c, text)
	local g = trim(text)
	if g == "" then return end
	if g == "ping" then return c.send("pong") end
	-- 前端偶尔发 JSON 包装的 {"cmd":".."};没有就当原始 AT
	local j = g:sub(1, 1) == "{" and json.parse(g)
	if type(j) == "table" and j.cmd then g = trim(tostring(j.cmd)) end
	local ok, res = pcall(exec_at, g)
	if not ok then io.stderr:write("genws: ", tostring(res), "\n"); res = fail(tostring(res)) end
	c.send(json.stringify(res))
end

-- ---------- WebSocket ----------
local function frame(op, payload)
	local n, h = #payload, nil
	if n < 126 then h = string.char(0x80 + op, n)
	elseif n < 65536 then h = string.char(0x80 + op, 126, rshift(n, 8), band(n, 255))
	else h = string.char(0x80 + op, 127, 0, 0, 0, 0, band(rshift(n, 24), 255), band(rshift(n, 16), 255), band(rshift(n, 8), 255), band(n, 255)) end
	return h .. payload
end
local function sendall(sock, data)
	while #data > 0 do
		local w = sock:send(data)
		if not w or w <= 0 then return false end
		data = data:sub(w + 1)
	end
	return true
end

local function pump(c)
	while true do
		local b = c.buf
		if #b < 2 then return true end
		local b1, b2 = b:byte(1, 2)
		local op, masked, len, off = band(b1, 15), band(b2, 128) ~= 0, band(b2, 127), 2
		if len == 126 then
			if #b < 4 then return true end
			len = b:byte(3) * 256 + b:byte(4); off = 4
		elseif len == 127 then
			if #b < 10 then return true end
			local x = { b:byte(3, 10) }
			if x[1] ~= 0 or x[2] ~= 0 or x[3] ~= 0 or x[4] ~= 0 then return false end
			len = ((x[5] * 256 + x[6]) * 256 + x[7]) * 256 + x[8]; off = 10
		end
		if len > MAXMSG then return false end
		local need = off + (masked and 4 or 0) + len
		if #b < need then return true end
		local payload
		if masked then
			local k = { b:byte(off + 1, off + 4) }
			local raw = b:sub(off + 5, need)
			local t = {}
			for i = 1, #raw do t[i] = string.char(bxor(raw:byte(i), k[(i - 1) % 4 + 1])) end
			payload = table.concat(t)
		else
			payload = b:sub(off + 1, need)
		end
		c.buf = b:sub(need + 1)
		local fin = band(b1, 128) ~= 0
		if op == 8 then
			sendall(c.sock, frame(8, "")); return false
		elseif op == 9 then
			sendall(c.sock, frame(10, payload))
		elseif op == 1 or op == 2 or op == 0 then
			if op ~= 0 then c.fop = op; c.msg = payload else c.msg = (c.msg or "") .. payload end
			if #c.msg > MAXMSG then return false end
			if fin then
				local m, o = c.msg, c.fop
				c.msg = nil
				if o ~= 2 then
					local ok, e = pcall(handle, c, m)
					if not ok then io.stderr:write("genws: ", tostring(e), "\n") end
				end
			end
		end
	end
end

local function handshake(c)
	local hdr = c.buf:match("^(.-)\r\n\r\n")
	if not hdr then return #c.buf < 8192 end
	c.buf = c.buf:sub(#hdr + 5)
	local key = hdr:match("[Ss]ec%-[Ww]eb[Ss]ocket%-[Kk]ey:%s*([%w%+/=]+)")
	if not key then
		sendall(c.sock, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
		return false
	end
	sendall(c.sock, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " ..
		accept_key(key) .. "\r\n\r\n")
	c.ws = true
	return true
end

-- ---------- 模组名写回 /www/gen/config.json(前端标题读它) ----------
local model_shown
local function sync_model()
	local k = kvm("base")
	local name = k.name and trim(tostring(k.name)) or ""
	if name == "" or name == model_shown then return end
	local s = readfile(CFGWEB)
	local j = s and json.parse(s)
	if type(j) ~= "table" then return end
	if j.model ~= name then
		j.model = name
		local f = io.open(CFGWEB, "w")
		if f then f:write(json.stringify(j), "\n"); f:close() end
	end
	model_shown = name
end

-- ---------- 主循环 ----------
lsock = nixio.bind("0.0.0.0", PORT, "inet", "stream")
if not lsock then io.stderr:write("genws: 绑定 0.0.0.0:", PORT, " 失败\n"); os.exit(1) end
lsock:setopt("socket", "reuseaddr", 1)
lsock:listen(16)

local IN = nixio.poll_flags("in")
local function drop(i)
	pcall(function() clients[i].sock:close() end)
	table.remove(clients, i)
end

local last_sync = 0
last_active = now()
while true do
	local pl = { { fd = lsock, events = IN } }
	for i, c in ipairs(clients) do pl[i + 1] = { fd = c.sock, events = IN } end
	local n = nixio.poll(pl, 1000)
	if n and n > 0 then
		if pl[1].revents ~= 0 then
			local s = lsock:accept()
			if s then
				s:setopt("socket", "sndtimeo", 5)
				if #clients >= MAXCLI then drop(1) end
				local c = { sock = s, buf = "", ws = false }
				c.send = function(t) return sendall(c.sock, frame(1, t)) end
				clients[#clients + 1] = c
				last_active = now()
			end
		end
		for i = #clients, 1, -1 do
			local c, p = clients[i], pl[i + 1]
			if p and p.revents ~= 0 then
				local d = c.sock:recv(65536)
				local keep = false
				if d and #d > 0 then
					c.buf = c.buf .. d
					local ok, r = pcall(function()
						if not c.ws and not handshake(c) then return false end
						if c.ws then return pump(c) end
						return true
					end)
					keep = ok and r
					if not ok then io.stderr:write("genws: ", tostring(r), "\n") end
				end
				if not keep then drop(i) end
			end
		end
	end
	if #clients > 0 then last_active = now() end
	tick()
	if now() - last_sync >= 10 then last_sync = now(); pcall(sync_model) end
end
