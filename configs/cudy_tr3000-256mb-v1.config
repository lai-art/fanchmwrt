#
# Cudy TR3000 256MB v1 —— FanchmWrt (OpenWrt 25.12.6) 构建配置
#
# 特点:
#   * 闭源 MTK 无线驱动 (kmod-mt_wifi) 取代开源 mt76
#   * Argon + Aurora 主题 (从 Mwrt 固件提取, 默认主题)
#   * Airpi GPIO PWM 风扇控制 + 侧栏破笼动画 (本地解锁)
#   * MTK 应用套件 / 4G-5G 模块支持 / fanchmwrt-packages 的 fwx 系列
#   * 无任何作者服务器依赖
#
# 说明: 本文件只列关键选型, 其余由 CI 里的 `make defconfig` 自动补全依赖。
#

# ==================== 目标设备 ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-v1=y

# ---------- 关闭内核全局 -Werror ----------
# toolchain/gcc/Config.version 里 GCC_USE_DEFAULT_VERSION 会 `imply KERNEL_WERROR`,
# 因此不显式关闭时内核以 -Werror 编译。MTK 这套闭源驱动按 6.6 编写(当时零警告),
# 在 6.12 上会因新增警告项直接编译失败, 例如:
#   warp_main.c: format-extra-args / unused-variable / incompatible-pointer-types
#   conninfra : missing-declarations
# 这些是移植代码的固有告警而非真实缺陷, 故关闭此选项。
# CONFIG_KERNEL_WERROR is not set

# ==================== 闭源无线驱动 (MTK mt_wifi) ====================
CONFIG_PACKAGE_kmod-mt_wifi=y
# 芯片接口: MT7981 (TR3000 的 SoC)
CONFIG_MTK_FIRST_IF_MT7981=y
# 使用新格式固件 (mt7981-fw-20240613), 并安装到 /lib/firmware
CONFIG_MTK_MT7981_NEW_FW=y
# FW_BIN_LOAD 必须为 y: Makefile 的 KernelPackage/mt_wifi/install 只有在该值=y 时
# 才把 WIFI_RAM_CODE_MT7981.bin 等拷进 /lib/firmware, 否则运行时驱动找不到固件。
CONFIG_MTK_WIFI_FW_BIN_LOAD=y

# ---------- conninfra: 必须显式选 APSOC + MT7981 ----------
# 源码 Makefile 只在 CONFIG_MTK_CONNINFRA_APSOC_MT7981=y 时才加
#   -I$(SUBDIRS)/platform/mt7981/include -DCONNINFRA_APSOC_MT7981
# 该选项 default n 且 choice 首项是 MT7986, 不选就拿不到平台头文件, 编译必失败。
CONFIG_MTK_CONNINFRA_APSOC=y
CONFIG_MTK_CONNINFRA_APSOC_MT7981=y
# 运行时行为: 连接子系统自行上电 / 支持 EMI (WiFi-BT 共存), 与移植来源的配置一致
CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y

# ---------- 校准数据来源 ----------
# MT7981 芯片内置 PA/LNA, 对应 iPAiLNA 的 e2p 镜像;
# choice 首项是 ePAeLNA(外部 PA/LNA), 不显式指定会拿到错误的默认 eeprom。
CONFIG_MTK_FIRST_IF_IPAILNA=y
# out-of-tree 移植版本(基于 6.6)用的是 flash 方式读取校准, 保持一致
CONFIG_MTK_FIRST_IF_EEPROM_FLASH=y

# ---------- warp: 必须显式指定硬件版本与芯片 ----------
# WARP_VERSION 的 default 只覆盖 mt7622/mt7986/mt7988 三个 target, filogic 下取不到值,
# 会落到 else 分支编成 V3 (MT7988 的硬件抽象); WARP_CHIPSET 默认还是 mt7988。
# MT7981 属于 WARP V2 系列, 对应 regs/reg_v2/warp_mt7981.c。
CONFIG_WARP_VERSION=2
CONFIG_WARP_CHIPSET="mt7981"

# ---------- 关闭开源 mt76 无线栈 ----------
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt76-sdio is not set
# CONFIG_PACKAGE_kmod-mt76-usb is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916-firmware is not set
# CONFIG_PACKAGE_kmod-mt7981-firmware is not set

# ==================== LuCI 基础与 Lua 兼容层 ====================
# argon 主题的模板、风扇页、破笼后端都是 Lua 写的, 必须带兼容层
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# ==================== 主题 (默认 Argon + Aurora 叠加) ====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-aurora=y
# 不装 fanchmwrt 自带主题, 避免与 argon 抢默认主题
# CONFIG_PACKAGE_luci-theme-fanchmwrt is not set

# ==================== 风扇控制 (Airpi GPIO PWM) ====================
CONFIG_PACKAGE_kmod-Airpi-gpio-fan=y
CONFIG_PACKAGE_luci-app-Airpifanctrl=y

# ==================== 侧栏破笼动画 + 本地解锁 ====================
CONFIG_PACKAGE_luci-app-mwrt-catcage=y

# ==================== MTK 应用套件 ====================
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtk=y
CONFIG_PACKAGE_datconf-lua=y
CONFIG_PACKAGE_mii_mgr=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_mtk-smp=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y

# ==================== 4G / 5G 模块支持 ====================
CONFIG_PACKAGE_luci-app-modem=y
CONFIG_PACKAGE_luci-app-cpe=y
CONFIG_PACKAGE_luci-app-sms-tool=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_sendat=y
CONFIG_PACKAGE_quectel-CM-5G=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_luci-app-usbmodem=y

# ==================== fanchmwrt-packages 应用 (fwx 系列) ====================
CONFIG_PACKAGE_luci-app-fwx-app-center=y
CONFIG_PACKAGE_luci-app-fwx-appfilter=y
CONFIG_PACKAGE_luci-app-fwx-dashboard=y
CONFIG_PACKAGE_luci-app-fwx-dashboard-setting=y
CONFIG_PACKAGE_luci-app-fwx-fastnat=y
CONFIG_PACKAGE_luci-app-fwx-feature=y
CONFIG_PACKAGE_luci-app-fwx-firewall=y
CONFIG_PACKAGE_luci-app-fwx-mac-blacklist=y
CONFIG_PACKAGE_luci-app-fwx-macfilter=y
CONFIG_PACKAGE_luci-app-fwx-network=y
CONFIG_PACKAGE_luci-app-fwx-record=y
CONFIG_PACKAGE_luci-app-fwx-record-whitelist=y
CONFIG_PACKAGE_luci-app-fwx-resources=y
CONFIG_PACKAGE_luci-app-fwx-session-stat=y
CONFIG_PACKAGE_luci-app-fwx-system=y
CONFIG_PACKAGE_luci-app-fwx-traffic-stat=y
CONFIG_PACKAGE_luci-app-fwx-user=y
CONFIG_PACKAGE_luci-app-fwx-user-record=y
CONFIG_PACKAGE_luci-app-fwx-wireless=y

# ==================== 常用系统组件 ====================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# luci-i18n-* 是 HIDDEN 包, 直接选会被 defconfig 丢弃; 用可见元包把它们拉进来
CONFIG_PACKAGE_luci-zh-cn-support=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ==================== 编译加速 ====================
CONFIG_CCACHE=y

# ==================== 镜像/内核尺寸 ====================
# 说明: 本机为 NAND + UBI (KERNEL_IN_UBI=1), 镜像实际大小由 filogic.mk 中
#       Device/cudy_tr3000-256mb-v1 的 IMAGE_SIZE := 235520k 决定,
#       CONFIG_TARGET_KERNEL_PARTSIZE / ROOTFS_PARTSIZE 对 UBI 设备不生效, 故不设置。
# 保留内核符号大小以利调试 (可选)
# CONFIG_KERNEL_DEBUG_INFO is not set

# ===========================================================================
# 厂家 MTK 驱动完整配置 (逐项取自 out-of-tree 移植来源的 6.6 版实际配置)
#
# 只配 10 项不够: 厂家配置共 95 项, 涵盖 802.11ax/VHT、APCLI、MBSS、
# WPA3/OWE/PMF、MU-MIMO、TWT、DFS、Band Steering、WARP V2 等能力开关,
# 缺项会编出功能残缺的驱动(例如只有 11n)。
#
# 两处有意偏离厂家配置:
#   MTK_WHNAT_SUPPORT / MTK_FAST_NAT_SUPPORT -> 均关闭。
#   二者引用 ra_sw_nat_hook_tx, 该符号由内核内建的 MTK HNAT 提供;
#   OpenWrt 25.12 的 mediatek target 已彻底移除 HNAT(无 kmod-mediatek_hnat,
#   generic/config-6.12 也没有 CONFIG_NET_MEDIATEK_HNAT), 开启会在 modpost
#   阶段报 undefined symbol。硬件 NAT 因此不可用, 走软件转发。
# ===========================================================================
CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
CONFIG_MTK_AIR_MONITOR=y
CONFIG_MTK_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_MTK_ATE_SUPPORT=y
CONFIG_MTK_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_CAL_BIN_FILE_SUPPORT=y
CONFIG_MTK_CFG_SUPPORT_FALCON_MURU=y
CONFIG_MTK_CFG_SUPPORT_FALCON_PP=y
CONFIG_MTK_CFG_SUPPORT_FALCON_SR=y
CONFIG_MTK_CFG_SUPPORT_FALCON_TXCMD_DBG=y
CONFIG_MTK_CHIP_MT7981=y
CONFIG_MTK_CON_WPS_SUPPORT=y
CONFIG_MTK_DBDC_MODE=y
CONFIG_MTK_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_DOT11R_FT_SUPPORT=y
CONFIG_MTK_DOT11W_PMF_SUPPORT=y
CONFIG_MTK_DOT11_HE_AX=y
CONFIG_MTK_DOT11_N_SUPPORT=y
CONFIG_MTK_DOT11_VHT_AC=y
CONFIG_MTK_GREENAP_SUPPORT=y
CONFIG_MTK_G_BAND_256QAM_SUPPORT=y
CONFIG_MTK_HDR_TRANS_RX_SUPPORT=y
CONFIG_MTK_HDR_TRANS_TX_SUPPORT=y
CONFIG_MTK_ICAP_SUPPORT=y
CONFIG_MTK_IGMP_SNOOP_SUPPORT=y
CONFIG_MTK_INTERWORKING=y
CONFIG_MTK_MAP_R2_6E_SUPPORT=y
CONFIG_MTK_MAP_R2_VER_SUPPORT=y
CONFIG_MTK_MAP_R3_6E_SUPPORT=y
CONFIG_MTK_MAP_R3_VER_SUPPORT=y
CONFIG_MTK_MAP_SUPPORT=y
CONFIG_MTK_MBO_SUPPORT=y
CONFIG_MTK_MBSS_DTIM_SUPPORT=y
CONFIG_MTK_MBSS_SUPPORT=y
CONFIG_MTK_MCAST_RATE_SPECIFIC=y
CONFIG_MTK_MEMORY_SHRINK=y
CONFIG_MTK_MEMORY_SHRINK_AGGRESS=y
CONFIG_MTK_MGMT_TXPWR_CTRL=y
CONFIG_MTK_MLME_MULTI_QUEUE_SUPPORT=y
CONFIG_MTK_MT_AP_SUPPORT=m
CONFIG_MTK_MT_DFS_SUPPORT=y
CONFIG_MTK_MT_MAC=y
CONFIG_MTK_MT_WIFI=m
CONFIG_MTK_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_MUMIMO_SUPPORT=y
CONFIG_MTK_MU_RA_SUPPORT=y
CONFIG_MTK_OFFCHANNEL_SCAN_FEATURE=y
CONFIG_MTK_OWE_SUPPORT=y
CONFIG_MTK_QOS_R1_SUPPORT=y
CONFIG_MTK_RA_PHY_RATE_SUPPORT=y
CONFIG_MTK_RED_SUPPORT=y
CONFIG_MTK_RTMP_FLASH_SUPPORT=y
CONFIG_MTK_RT_FIRST_CARD_EEPROM="flash"
CONFIG_MTK_RT_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_SCS_FW_OFFLOAD=y
CONFIG_MTK_SECOND_IF_NONE=y
CONFIG_MTK_SMART_CARRIER_SENSE_SUPPORT=y
CONFIG_MTK_SPECTRUM_SUPPORT=y
CONFIG_MTK_SUPPORT_OPENWRT=y
CONFIG_MTK_THIRD_IF_NONE=y
CONFIG_MTK_TPC_SUPPORT=y
CONFIG_MTK_TXBF_SUPPORT=y
CONFIG_MTK_UAPSD=y
CONFIG_MTK_VLAN_SUPPORT=y
CONFIG_MTK_VOW_SUPPORT=y
# MTK_WARP_V2 依赖 MTK_WHNAT_SUPPORT, 而后者在本树无 HNAT 实现, 只能关闭
# CONFIG_MTK_WARP_V2 is not set
CONFIG_MTK_WDS_SUPPORT=y
CONFIG_MTK_WIFI_BASIC_FUNC=y
CONFIG_MTK_WIFI_DRIVER=y
CONFIG_MTK_WIFI_EAP_FEATURE=y
CONFIG_MTK_WIFI_MODE_AP=m
CONFIG_MTK_WIFI_MT_MAC=y
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WLAN_HOOK=y
CONFIG_MTK_WLAN_SERVICE=y
CONFIG_MTK_WNM_SUPPORT=y
CONFIG_MTK_WPA3_SUPPORT=y
CONFIG_MTK_WSC_INCLUDED=y
CONFIG_MTK_WSC_V2_SUPPORT=y
CONFIG_WARP_DBG_SUPPORT=y
